  "metric_definitions": {
    "axis_brier_scores": "Binary Brier scores after aggregating quadrants into growth-up and inflation-up probabilities.",
    "balanced_accuracy": "Mean recall across realized regimes, giving rare regimes equal weight.",
    "brier_skill_vs_transition_only": "One minus model Brier divided by transition-only Brier; positive values improve on the causal transition baseline.",
    "expected_calibration_error": "Bin-weighted gap between forecast probabilities and realized frequencies; reported for top-label and classwise views.",
    "macro_f1": "Mean harmonic precision-recall score across active realized or predicted regimes.",
    "map_accuracy": "Share of maximum-probability regime calls that are correct.",
    "multiclass_brier_score": "Mean unscaled sum of squared four-class probability errors, bounded from 0 to 2; lower is better.",
    "negative_log_likelihood": "Mean -log probability assigned to the realized regime; lower is better and exact zero probability has infinite loss.",
    "posterior_entropy": "Average uncertainty/sharpness in nats; lower is sharper but not necessarily more accurate."
